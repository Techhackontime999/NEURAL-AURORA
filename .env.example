# ---------------------------------------------------------------------------
# Server-side AI gateway (/api/ai) — puzzle, portfolio assistant, terminal,
# Mithi and voice all use these variables.
# ---------------------------------------------------------------------------
# NEVER use a VITE_ prefix for an AI key: Vite inlines VITE_* values into the
# public browser bundle. The browser only calls /api/ai; keys stay here.
#
# Option A — OpenRouter (recommended, fixed base)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=openai/gpt-4o-mini
#
# Option B — any OpenAI-compatible provider
# AI_API_KEY=your_ai_api_key
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Option C — Google Gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash
#
# With no key configured, AI features show an honest unavailable state and
# the puzzle gate falls back to built-in static questions.

# Required for dynamic content: Supabase project URL and anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# (Server-side only) Supabase service role key for privileged operations (e.g., payment webhook verification)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# (Server-side only) Plain URL reference for serverless functions; the webhook falls back to VITE_SUPABASE_URL
# SUPABASE_URL=https://your-project.supabase.co

# Optional: separate server-side voice / TTS settings for /api/ai (feature=voice).
# With no VOICE_* values, the gateway reuses the chat provider above when it
# supports /audio/speech. A Gemini-only deployment needs both VOICE_* values.
# The browser falls back to built-in SpeechSynthesis when voice is unavailable.
# VOICE_API_BASE=https://openrouter.ai/api/v1
# VOICE_API_KEY=your_voice_api_key
# VOICE_MODEL=openai/tts-1-hd

# Admin accounts are created through Supabase Auth, then promoted in the
# profiles table (see supabase-schema.sql). No admin email, role or password
# is stored in the browser environment.

# Optional: Jamendo API client ID for real background music
# Get a free key at https://devportal.jamendo.com
# If not set, falls back to Web Audio synth (ambient tones)
VITE_JAMENDO_CLIENT_ID=your_jamendo_client_id

# Required for YouTube Browse verification ("Channel Stream" mode): YouTube Data API v3 key
# Get a free key at https://console.cloud.google.com (enable YouTube Data API v3)
VITE_YOUTUBE_API_KEY=your_youtube_api_key
# Optional: Default channel ID for YouTube Browse (can also be set via admin panel)
VITE_YOUTUBE_CHANNEL_ID=UC_your_channel_id

# Required for donations, services & the digital store: Razorpay Payment Gateway
# Get keys at https://dashboard.razorpay.com
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# (Server-side only) Razorpay Webhook Secret (or RAZORPAY_KEY_SECRET) for webhook verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---------------------------------------------------------------------------
# Digital store (/offerings/products)
# ---------------------------------------------------------------------------
# The store needs NO new secrets beyond the ones above. It reuses:
#   VITE_SUPABASE_URL            browser reads the published catalogue
#   VITE_SUPABASE_ANON_KEY       browser auth + RLS-scoped reads
#   SUPABASE_SERVICE_ROLE_KEY    /api/create-order, /api/razorpay-webhook,
#                                /api/download, /api/order-status
#   RAZORPAY_KEY_ID/_SECRET      server-side order creation
#   RAZORPAY_WEBHOOK_SECRET      signature verification of the raw webhook body
#   VITE_RAZORPAY_KEY_ID         opens the Razorpay Checkout modal
#
# If SUPABASE_URL is unset the serverless functions fall back to
# VITE_SUPABASE_URL. Product purchases FAIL CLOSED when the database or the
# service-role key is missing — there is no client-side price fallback.

# ---------------------------------------------------------------------------
# Monetization — Google AdSense + direct sponsors
# ---------------------------------------------------------------------------
# Placements are managed in /admin/ad-placements. These values are the fallback
# used before a database row exists; leave a slot blank for responsive auto ads.
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_ENABLED=true
# VITE_ADSENSE_SLOT_BLOG_LISTING=
# VITE_ADSENSE_SLOT_ARTICLE_FOOTER=
# VITE_ADSENSE_SLOT_STORE_LISTING=
# VITE_ADSENSE_SLOT_PRODUCT_DETAIL=
# VITE_ADSENSE_SLOT_SEARCH_RESULTS=
# VITE_ADSENSE_SLOT_OFFERINGS=

# Optional: absolute origin used by the server-rendered sitemap and previews.
# SITE_ORIGIN=https://neural-aurora.vercel.app

