# Required: AI provider for the puzzle generator & portfolio assistant
# (any OpenAI-compatible API with CORS support). Examples:
#   OpenRouter:    https://openrouter.ai/api/v1  (use OpenRouter API key - recommended)
#   OpenAI:        https://api.openai.com/v1     (use OpenAI API key)
# NOTE: OpenCode Zen API (https://opencode.ai/zen/v1) does NOT support CORS
# and cannot be called from browser-based apps (preflight fails).
# If not set, falls back to hardcoded static questions.
VITE_AI_API_BASE=https://openrouter.ai/api/v1
VITE_AI_API_KEY=your_ai_api_key_here
VITE_AI_MODEL=openai/gpt-4o-mini

# Required for dynamic content: Supabase project URL and anon key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# (Server-side only) Supabase service role key for privileged operations (e.g., payment webhook verification)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Separate AI voice / TTS provider (defaults to OpenRouter)
# If VITE_VOICE_API_BASE is not set, falls back to https://openrouter.ai/api/v1
# If VITE_VOICE_API_KEY is not set, falls back to VITE_AI_API_KEY
# Uses browser SpeechSynthesis if both voice model and key are empty.
VITE_VOICE_API_BASE=https://openrouter.ai/api/v1
VITE_VOICE_API_KEY=your_voice_api_key_here
VITE_VOICE_MODEL=openai/tts-1-hd

# Optional: Superuser email for auto-promotion to admin.
# On first deploy, register with this email to become admin.
# The database trigger in supabase-schema.sql handles promotion.
VITE_SUPERUSER_EMAIL=admin@example.com
# VITE_SUPERUSER_PASSWORD=your_password

# Optional: Jamendo API client ID for real background music
# Get a free key at https://devportal.jamendo.com
# If not set, falls back to Web Audio synth (ambient tones)
VITE_JAMENDO_CLIENT_ID=your_jamendo_client_id

# Required for YouTube Browse verification ("Channel Stream" mode): YouTube Data API v3 key
# Get a free key at https://console.cloud.google.com (enable YouTube Data API v3)
VITE_YOUTUBE_API_KEY=your_youtube_api_key
# Optional: Default channel ID for YouTube Browse (can also be set via admin panel)
VITE_YOUTUBE_CHANNEL_ID=UC_your_channel_id

# Required for donations & services: Razorpay Payment Gateway
# Get keys at https://dashboard.razorpay.com
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# (Server-side only) Razorpay Webhook Secret (or RAZORPAY_KEY_SECRET) for webhook verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

